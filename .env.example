# Copy to .env and fill in local values. Do not commit .env.
# Django signing key; generate a private value for each environment.
SECRET_KEY=
# Set True for local development and False in deployment.
DEBUG=
# Comma-separated hostnames allowed to serve this Django app.
ALLOWED_HOSTS=
# Comma-separated origins trusted for unsafe CSRF requests; may be empty.
CSRF_TRUSTED_ORIGINS=
# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=
# PostgreSQL URL; when set, it takes precedence over the local DB_* values.
DATABASE_URL=
# Render supplies this hostname automatically for a Render web service.
RENDER_EXTERNAL_HOSTNAME=
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
# Leave EMAIL_BACKEND unset to print emails in the terminal during local development.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=BobTronics <no-reply@bobtronics.local>
SITE_URL=http://localhost:8000
REDIS_URL=redis://127.0.0.1:6379/1
