# Copy to .env and fill in local values. Do not commit .env.
SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
# Leave EMAIL_BACKEND unset to print emails in the terminal during local development.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=BobTronics <no-reply@bobtronics.local>
SITE_URL=http://localhost:8000
REDIS_URL=redis://127.0.0.1:6379/1
